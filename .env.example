# ==========================================================================
#  Todo el agente corre LOCAL con Ollama. Ninguna orden de servicio —con el
#  nombre, la cedula y la direccion de una persona— sale de esta maquina.
#
#  Preparacion (una sola vez):
#    ollama serve
#    ollama pull qwen2.5:7b          # modelo del agente (tool calling)
#    ollama pull bge-m3              # embeddings del RAG (multilingue)
#    ollama pull gemma3:4b          # vision: leer la foto de la orden
#    ollama create haceb-agente -f Modelfile   # qwen2.5:7b con la ventana horneada
# ==========================================================================

OLLAMA_HOST=localhost:11434

# El modelo del Modelfile, no `qwen2.5:7b` a secas: la ventana de contexto va
# horneada ahi. El endpoint /v1 de Ollama ignora `options`, asi que pasarla en
# la llamada no sirve — el modelo carga con 4096 y los turnos salen vacios.
OLLAMA_MODEL=haceb-agente
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_NUM_CTX=16384

# Vision para leer la foto de la orden de servicio (gemma3 tiene vision; qwen no).
OLLAMA_VISION_MODEL=gemma3:4b

# Auditor de las respuestas:
#   literalidad -> deterministico, 0.03 ms. Toda cifra de la respuesta tiene que
#                  estar en la evidencia. Atrapa montos y años inventados.
#   llm         -> un segundo modelo audita tambien lo cualitativo, pero tarda
#                  26-86 s y esa espera se le suma entera al usuario.
VALIDADOR=literalidad
OLLAMA_MODEL_VALIDADOR=haceb-agente

# --- Opcional: correr en la nube en vez de local --------------------------
# Si se define alguna de estas, tiene prioridad Ollama > Groq > Gemini.
# GROQ_API_KEY=            # https://console.groq.com/keys
# GOOGLE_API_KEY=          # https://aistudio.google.com/apikey
